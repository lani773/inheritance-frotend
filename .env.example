# INHERITANCE CHOIR — Environment Variables
# Copy this file to .env and fill in your values

# ── Backend API (leave blank to use localStorage mode) ─────────────
REACT_APP_API_URL=http://localhost:8080/api/v1
REACT_APP_WS_URL=ws://localhost:8080/ws

# ── Storage Mode ────────────────────────────────────────────────────
# Set to 'false' to use the real backend API instead of localStorage
REACT_APP_USE_LOCAL_STORAGE=true

# ── App Config ───────────────────────────────────────────────────────
REACT_APP_POLL_INTERVAL=3000
