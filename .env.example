# INHERITANCE CHOIR — Environment Variables
# Copy this file to .env and fill in your values

# ── Backend API (leave blank to use localStorage mode) ─────────────
# Local Development:
# REACT_APP_API_URL=http://localhost:8080/api/v1
# REACT_APP_WS_URL=ws://localhost:8080/ws

# Production (Render):
REACT_APP_API_URL=https://inheritance-backend-2ubt.onrender.com/api/v1
REACT_APP_WS_URL=wss://inheritance-backend-2ubt.onrender.com/ws

# ── Storage Mode ────────────────────────────────────────────────────
# Set to 'false' to use the real backend API instead of localStorage
REACT_APP_USE_LOCAL_STORAGE=false

# ── App Config ───────────────────────────────────────────────────────
REACT_APP_POLL_INTERVAL=3000
